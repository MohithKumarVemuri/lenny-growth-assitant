# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="The Lenny Growth Assistant"
DEBUG=false

# ------------------------------------------------------------------------------
# Persistence & Database Configuration
# ------------------------------------------------------------------------------
# Primary (PostgreSQL + pgvector for Docker / Supabase / Railway):
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant

# SQLite Fallback (automatically used if PostgreSQL is not reachable):
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./lenny_assistant.db

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# ------------------------------------------------------------------------------
# Default provider on startup: 'ollama' | 'claude' | 'openai' | 'sim'
DEFAULT_PROVIDER=ollama

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM - Anthropic (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloud LLM - OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# RAG Retrieval Settings
# ------------------------------------------------------------------------------
EMBEDDING_DIM=384
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.45
USE_SENTENCE_TRANSFORMERS=false

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
